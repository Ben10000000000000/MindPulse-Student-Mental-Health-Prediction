# Copy this file to ".env" (same folder) and edit. The API reads it automatically.
MONGO_URI=mongodb://localhost:27017
# Atlas example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=mental_health_db
MONGO_COLLECTION=predictions
# true = /predict refuses to answer when the result cannot be saved (nothing is ever lost silently)
MONGO_REQUIRED=false
# client = each browser sees only its own history | all = show every record (fine for a private demo)
HISTORY_SCOPE=client

# --- MindPulse authentication (required for signup/login) ---
# Generate a long random value; do not share it publicly.
AUTH_SECRET=MindPulse_2026_9xK7mP2qL8vN4SecureAuthSecret
AUTH_TOKEN_TTL_HOURS=24
AUTH_OTP_TTL_MINUTES=10
# This URL is placed in verification/reset emails.
PUBLIC_APP_URL=http://127.0.0.1:8000/app

# Gmail SMTP. Use a Gmail App Password, NOT your normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
