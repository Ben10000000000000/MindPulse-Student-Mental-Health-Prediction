# MindPulse environment settings
# Copy this file to ".env" and fill in your own values.
# NEVER upload ".env" to GitHub.

# --- Authentication ---
# Long random text, at least 32 characters. Change it.
AUTH_SECRET=change-me-to-a-long-random-secret
AUTH_TOKEN_TTL_HOURS=24
AUTH_OTP_TTL_MINUTES=10

# --- Email (Gmail OTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
# Gmail App Password (16 characters), not your normal Gmail password
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-sender@gmail.com

# --- App address ---
PUBLIC_APP_URL=http://127.0.0.1:8000/app

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=mental_health_db
MONGO_COLLECTION=predictions
MONGO_REQUIRED=false
HISTORY_SCOPE=client